# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL runtime environment variables (injected by AI Studio Cloud SQL proxy)
SQL_HOST="/app/cloudsql/marine-card-3smzh:europe-west3:ai-studio-2488b297"
SQL_DB_NAME="cloud_sql_development_database"
SQL_USER="ai_studio_app_user"
SQL_PASSWORD="password"
SQL_ADMIN_USER="ai_studio_admin"
SQL_ADMIN_PASSWORD="password"

# Cloudflare Stream API Credentials (for direct video upload & HLS transcoding)
CF_ACCOUNT_ID="your_cloudflare_account_id"
CF_API_TOKEN="your_cloudflare_stream_api_token"
