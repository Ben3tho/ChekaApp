# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL runtime environment variables (injected by AI Studio Cloud SQL proxy)
SQL_HOST="/app/cloudsql/marine-card-3smzh:europe-west3:ai-studio-2488b297"
SQL_DB_NAME="cloud_sql_development_database"
SQL_USER="ai_studio_app_user"
SQL_PASSWORD="password"
SQL_ADMIN_USER="ai_studio_admin"
SQL_ADMIN_PASSWORD="password"

# Cloudflare Stream API Credentials (for direct video upload & HLS transcoding)
CF_ACCOUNT_ID="your_cloudflare_account_id"
CF_API_TOKEN="your_cloudflare_stream_api_token"

# Selcom Business API Gateway (M-Pesa, Tigo Pesa, Airtel Money, HaloPesa)
SELCOM_API_KEY="your_selcom_api_key"
SELCOM_API_SECRET="your_selcom_api_secret_or_rsa_private_key"
SELCOM_VENDOR_ID="your_selcom_vendor_id"
SELCOM_BASE_URL="https://sandbox.selcom.business"

# AzamPay API Gateway (M-Pesa, Tigo Pesa, Airtel Money, HaloPesa, AzamPesa)
AZAMPAY_APP_NAME="ChekaApp"
AZAMPAY_CLIENT_ID="your_azampay_client_id"
AZAMPAY_CLIENT_SECRET="your_azampay_client_secret"
AZAMPAY_ENVIRONMENT="sandbox" # or "production"
# Snippe API Gateway (Tanzanian Mobile Money: M-Pesa, Tigo Pesa, Airtel Money, HaloPesa)
SNIPPE_API_KEY="your_snippe_api_key_here"
SNIPPE_WEBHOOK_SECRET="your_snippe_webhook_secret_here"
